# PostgreSQL Connection (REQUIRED on Vercel for login & HRM data)
# Option 1 (Recommended for Vercel - Neon / Supabase / Railway / Cloud SQL):
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Option 2 (Alternative separate SQL variables instead of DATABASE_URL):
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
# Optional SSL override ("true" | "false"). Auto-enabled on Vercel / non-local hosts:
DB_SSL=""

# Authentication & Session Signing (REQUIRED on Vercel)
DEMO_AUTH_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"
DEMO_PASSWORD="demo123"

# Optional Firebase Project Override (defaults to firebase-applet-config.json)
FIREBASE_PROJECT_ID=""

# Optional Server-Side Gemini AI & App URL
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

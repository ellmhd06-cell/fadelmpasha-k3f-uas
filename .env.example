# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (or your custom domain URL in production).
APP_URL="MY_APP_URL"

# PostgreSQL / Cloud SQL configuration (for standalone Cloud Run / custom domain publishing)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
# Or provide a full PostgreSQL connection string instead of individual SQL_* variables:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Demo Authentication Secret (set a strong random string when publishing externally)
DEMO_AUTH_SECRET="CHANGE_ME_IN_PRODUCTION"
DEMO_PASSWORD="demo123"
